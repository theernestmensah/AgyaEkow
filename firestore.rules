rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'eanmensah@gmail.com',
          'uriahmensah@gmail.com'
        ];
    }

    match /tributes/{tributeId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'relationship', 'message', 'date', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.relationship is string &&
        request.resource.data.relationship.size() <= 80 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 1 &&
        request.resource.data.message.size() <= 900 &&
        request.resource.data.date is string &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /videoTributes/{videoTributeId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /tvShows/{showId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /meta/candles {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count in [0, 1] &&
        request.resource.data.updatedAt == request.time;
      allow update: if
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        resource.data.count is number &&
        request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
