{
  "functions": {
    "api/server.js": {
      "includeFiles": [
        "index.html",
        "tributes.html",
        "admin.html",
        "styles.css",
        "script.js",
        "grandpa.jpeg",
        "robots.txt"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/:path*",
      "destination": "/api/server.js"
    }
  ]
}
